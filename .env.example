# Copy to .env — it is gitignored. docker compose reads it automatically.

# Gmail app password (NOT your login password). Without it, email alerts and
# outbound application sends fail; ntfy push still works.
SMTP_PASSWORD=

# Only needed if you set [linkedin_voyager] enabled = true in config.toml.
LI_AT=
LI_JSESSIONID=

# Optional. What the alert emails and the ntfy button link to. Change this if
# you put the dashboard behind a reverse proxy or tunnel.
# RADAR_BASE_URL=http://127.0.0.1:8080

# Optional. Turn up for debugging a source: hiring_radar=debug
# RUST_LOG=hiring_radar=info,tower_http=warn

# The model that reads postings, when [llm] provider = "openai" in config.toml.
# Any OpenAI-compatible key works — OpenRouter, Groq, a local gateway — paired
# with the matching base_url. RADAR_LLM_API_KEY is accepted as an alias.
OPENAI_API_KEY=
